# Supabase project URL and public anon key.
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses every security policy in the database:
# keep it out of the browser, out of commits, and out of chat.
# Needed by the ingestion jobs only.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string; protects the /api/cron/* endpoints.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Direct Postgres connection, for `npm run db:push` only.
# Dashboard > Project Settings > Database > Connection string > URI.
# Contains your database password: keep it out of commits and out of chat.
# Use the direct connection or session pooler, not the 6543 transaction pooler.
SUPABASE_DB_URL=

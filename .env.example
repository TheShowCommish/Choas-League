# Supabase project URL and public anon key.
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses every security policy in the database:
# keep it out of the browser, out of commits, and out of chat.
# Needed by the ingestion jobs only.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string; protects the /api/cron/* endpoints.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Postgres connection, for `npm run db:push` only. The anon and
# service-role keys cannot do this: they go through PostgREST, which
# will not run DDL.
#
# Dashboard > Project Settings > Database > Connection string. Copy the
# *Session pooler* string -- the direct connection is IPv6-only and will
# not reach most home networks, and the transaction pooler on 6543
# cannot hold the advisory lock the push takes.
#
# Contains your database password: keep it out of commits and out of chat.
SUPABASE_DB_URL=

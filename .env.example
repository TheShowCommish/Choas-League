# Supabase project URL and public anon key.
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses every security policy in the database:
# keep it out of the browser, out of commits, and out of chat.
# Needed by the ingestion jobs only.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string; protects the /api/cron/* endpoints.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
